# Copy to .env.local (git-ignored). Every VITE_* value is public in the browser bundle.
# Gateway: IDE = 5000, Docker = 8080.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Address printed in table QR codes, for example https://app.yourbrand.vn (same value as APP_URL of the backend).
# Empty = the address of the page. A phone cannot open a code printed from localhost.
VITE_PUBLIC_APP_URL=

# Quick sign-in buttons on /login and /customer-login, dev builds only. Put the values in .env.local, never here:
# VITE_DEMO_PASSWORD = DEMO_PASSWORD of .env.demo-accounts, VITE_DEMO_ADMIN_PASSWORD = SEED_ADMIN_PASSWORD of the backend .env.
VITE_DEMO_PASSWORD=
VITE_DEMO_ADMIN_PASSWORD=
VITE_AI_BASE_URL=http://localhost:8090/api/v1/ai

# true = in-memory demo (Firebase public site). false = talk to the gateway.
VITE_USE_MOCK=true

# "Continue with Google": OAuth client id (Google Cloud Console > Credentials > OAuth client ID, type Web application,
# authorized JavaScript origin http://localhost:8443). The same id goes into the backend as GOOGLE_CLIENT_ID. Empty: Google sign-in is off.
VITE_GOOGLE_CLIENT_ID=
